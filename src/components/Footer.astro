---
const links = [
  { href: '#about', label: 'אודות' },
  { href: '#gallery', label: 'עבודות' },
  { href: '#process', label: 'תהליך' },
  { href: '#testimonials', label: 'המלצות' },
  { href: '#contact', label: 'צור קשר' },
];
---

<footer class="bg-wood-dark text-cream">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:justify-between">
      <!-- Logo + tagline -->
      <div class="text-center lg:text-start">
        <div class="flex items-center justify-center gap-2 lg:justify-start">
          <svg
            class="h-7 w-7 text-wood-light"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22v-7"></path>
            <path d="M12 15c-3 0-5-2-5-5a5 5 0 0 1 10 0c0 3-2 5-5 5Z"></path>
            <path d="M12 9 9 6m3 3 3-3"></path>
          </svg>
          <span class="text-xl font-extrabold">אומן העץ</span>
        </div>
        <p class="mt-2 text-sm text-cream/70">עיצוב עץ בהתאמה אישית</p>
      </div>

      <!-- Nav links -->
      <nav class="flex flex-wrap justify-center gap-6">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-cream/80 transition-colors hover:text-wood-light"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Social -->
      <div class="flex gap-4">
        <a
          href="#"
          aria-label="Instagram"
          class="text-cream/80 transition-colors hover:text-wood-light"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a
          href="#"
          aria-label="Facebook"
          class="text-cream/80 transition-colors hover:text-wood-light"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-cream/10 pt-6 text-center text-sm text-cream/60">
      © 2025 אומן העץ. כל הזכויות שמורות.
    </div>
  </div>
</footer>
