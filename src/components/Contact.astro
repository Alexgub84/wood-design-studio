---
const whatsappHref =
  'https://wa.me/972540000000?text=שלום,%20אשמח%20לדבר%20על%20פרויקט%20עץ';
---

<section id="contact" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-extrabold text-wood-dark sm:text-4xl">
        בואו נדבר
      </h2>
      <p class="text-base text-wood-dark/70 sm:text-lg">
        מוכן להתחיל פרויקט? נשמח לשמוע ממך
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Contact info -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 text-lg text-wood-dark">
          <span>📞</span>
          <a href="tel:0540000000" class="hover:text-wood-medium">054-000-0000</a>
        </div>
        <div class="flex items-center gap-3 text-lg text-wood-dark">
          <span>📧</span>
          <a href="mailto:info@uman-haetz.co.il" class="hover:text-wood-medium">
            info@uman-haetz.co.il
          </a>
        </div>
        <div class="flex items-center gap-3 text-lg text-wood-dark">
          <span>📍</span>
          <span>תל אביב, ישראל</span>
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex w-full items-center justify-center gap-3 rounded-lg bg-green-600 px-8 py-4 text-lg font-bold text-white shadow-md transition-colors hover:bg-green-700"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"
            ></path>
          </svg>
          שלח הודעה בוואטסאפ
        </a>
      </div>

      <!-- Contact form -->
      <form id="contact-form" class="space-y-5" novalidate>
        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-wood-dark">
            שם מלא
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-lg border border-cream-dark bg-white px-4 py-3 text-wood-dark focus:border-wood-medium focus:outline-none focus:ring-2 focus:ring-wood-light"
          />
        </div>
        <div>
          <label for="email" class="mb-1 block text-sm font-medium text-wood-dark">
            אימייל
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-cream-dark bg-white px-4 py-3 text-wood-dark focus:border-wood-medium focus:outline-none focus:ring-2 focus:ring-wood-light"
          />
        </div>
        <div>
          <label for="phone" class="mb-1 block text-sm font-medium text-wood-dark">
            טלפון
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full rounded-lg border border-cream-dark bg-white px-4 py-3 text-wood-dark focus:border-wood-medium focus:outline-none focus:ring-2 focus:ring-wood-light"
          />
        </div>
        <div>
          <label for="project-type" class="mb-1 block text-sm font-medium text-wood-dark">
            סוג פרויקט
          </label>
          <select
            id="project-type"
            name="project-type"
            class="w-full rounded-lg border border-cream-dark bg-white px-4 py-3 text-wood-dark focus:border-wood-medium focus:outline-none focus:ring-2 focus:ring-wood-light"
          >
            <option value="שולחן">שולחן</option>
            <option value="מיטה">מיטה</option>
            <option value="ארון">ארון</option>
            <option value="מדף">מדף</option>
            <option value="אחר">אחר</option>
          </select>
        </div>
        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-wood-dark">
            תיאור הפרויקט
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full rounded-lg border border-cream-dark bg-white px-4 py-3 text-wood-dark focus:border-wood-medium focus:outline-none focus:ring-2 focus:ring-wood-light"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-wood-medium px-8 py-3 text-base font-bold text-cream transition-colors hover:bg-wood-dark"
        >
          שלח פנייה
        </button>
        <p
          id="form-success"
          class="hidden rounded-lg bg-green-50 px-4 py-3 text-center font-medium text-green-700"
        >
          הטופס ישלח בקרוב 🙂
        </p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    success.classList.remove('hidden');
    form.reset();
  });
</script>
