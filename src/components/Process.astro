---
const steps = [
  {
    title: 'שיחה ראשונה',
    description: 'נפגשים לשיחה ללא עלות - אני מקשיב לרצונות שלך ומבין את הצרכים',
  },
  {
    title: 'עיצוב ותכנון',
    description: 'מציג לך סקיצות ותוכניות - נחד מגיעים לעיצוב המושלם',
  },
  {
    title: 'בחירת חומרים',
    description: 'ביחד בוחרים את סוג העץ, הגימור והחומרים המשלימים',
  },
  {
    title: 'ייצור בסדנה',
    description: 'אני מייצר כל פיסה בעצמי בסדנה שלי - ללא קיצורי דרך',
  },
  {
    title: 'משלוח והרכבה',
    description: 'מגיע אליך, מרכיב ומוודא שאתה מרוצה לגמרי',
  },
];
---

<section id="process" class="bg-wood-dark py-20 text-cream sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-extrabold text-cream sm:text-4xl">
        איך אנחנו עובדים
      </h2>
      <p class="text-base text-wood-light sm:text-lg">
        מהרעיון ועד לרהיט המושלם בביתך
      </p>
    </div>

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((step, i) => (
          <div class="flex items-start gap-4 lg:flex-col lg:items-center lg:text-center">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-wood-light text-xl font-extrabold text-wood-dark">
              {i + 1}
            </div>
            <div>
              <h3 class="mb-2 text-lg font-bold text-cream">{step.title}</h3>
              <p class="text-sm leading-relaxed text-cream/70">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
