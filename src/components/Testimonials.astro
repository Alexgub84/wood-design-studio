---
const testimonials = [
  {
    quote:
      'קיבלתי שולחן אוכל מדהים שהפך לפוקוס של כל הסלון. עבודה מדויקת, שירות אישי ותוצאה שעולה על כל ציפייה!',
    name: 'רחל ויצמן',
    location: 'תל אביב',
  },
  {
    quote:
      'הזמנתי ארון בגדים בהתאמה אישית לחדר שינה קטן. הפתרון שקיבלתי היה מושלם - ניצל כל סנטימטר ונראה פשוט יפהפה.',
    name: 'דניאל כהן',
    location: 'הרצליה',
  },
  {
    quote:
      'שולחן הקפה שעיצבנו ביחד הפך לשיחת המסיבות. כל אחד ששואל מאיפה - לא מאמין שזה ייצור מקומי ישראלי. גאה להמליץ!',
    name: 'מיכל לוי',
    location: 'ירושלים',
  },
];
---

<section id="testimonials" class="bg-cream-dark py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-wood-dark sm:text-4xl">
        מה אומרים הלקוחות
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      {
        testimonials.map((t) => (
          <div class="relative rounded-xl bg-white p-8 shadow-sm">
            <span class="absolute end-6 top-4 font-serif text-6xl leading-none text-wood-light/40">
              ”
            </span>
            <div class="mb-4 text-lg text-wood-light">★★★★★</div>
            <p class="mb-6 text-base leading-relaxed text-wood-dark/80">
              {t.quote}
            </p>
            <div class="border-t border-cream-dark pt-4">
              <div class="font-bold text-wood-dark">{t.name}</div>
              <div class="text-sm text-wood-dark/60">{t.location}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
